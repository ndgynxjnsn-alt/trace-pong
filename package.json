{
  "name": "tracepong-live-panel",
  "version": "1.4.0",
  "description": "Live service traffic replayed from Tempo traces on a service graph, drawn with WebGPU (Grafana panel plugin)",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "dist": "npm run typecheck && node build.mjs --zip"
  },
  "devDependencies": {
    "@grafana/data": "13.1.0",
    "@grafana/runtime": "13.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "d3-force": "^3.0.1"
  }
}
